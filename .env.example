# Cardano Network (emulator, preprod, preview, or mainnet)
NETWORK=emulator

# Blockfrost API Key (Project ID) from https://blockfrost.io
# For preprod, the key starts with 'preprod...'
BLOCKFROST_PROJECT_ID=

# Backend Server Configuration
HOST=localhost
PORT=8080

# Static Assets Path (default: frontend/public)
PUBLIC_DIR=frontend/public

